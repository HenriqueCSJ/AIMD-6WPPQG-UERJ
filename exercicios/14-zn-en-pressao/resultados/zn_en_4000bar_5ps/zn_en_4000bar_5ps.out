NAME = zn_en_4000bar_5ps.inp
|  1> # Paired pressure pilot from separated fragments; no coordination restraints.
|  2> ! MD XTB2 ALPB(water) PAL8
|  3> %maxcore 256
|  4> %md
|  5>   Timestep 0.25_fs
|  6>   Randomize 42
|  7>   Initvel 300_K
|  8>   Cell Sphere 0, 0, 0, 9.0_A Spring 50 Elastic 100_fs, 0.0005 Pressure 4000
|  9>   Dump Position Stride 2 Filename "zn_en_4000bar_5ps-traj.xyz"
| 10>   Dump Velocity Stride 2000 Filename "zn_en_4000bar_5ps-vel.xyz"
| 11>   Thermostat CSVR 300_K Timecon 20_fs
| 12>   Run 2000
| 13>   # Continue inside the same MD process, preserving the elastic wall history.
| 14>   Thermostat CSVR 300_K Timecon 100_fs
| 15>   Run 18000
| 16> end
| 17> * xyzfile 2 1 zn_20h2o_3en_r9.xyz
| 18> 
| 19>                          ****END OF INPUT****
