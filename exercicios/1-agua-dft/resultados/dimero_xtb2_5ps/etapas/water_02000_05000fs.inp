# Finite NVE continuation; positions and velocities retained from checkpoint.
! MD XTB2 PAL8
%maxcore 256
%md
  Timestep 0.5_fs
  Thermostat None
  Randomize 42
  Dump Position Stride 1 Filename "water_02000_05000fs-traj.xyz"
  Restart "dimero_xtb2_2ps.mdrestart"
  Run 6000
end
* xyzfile 0 1 water_restart.xyz
