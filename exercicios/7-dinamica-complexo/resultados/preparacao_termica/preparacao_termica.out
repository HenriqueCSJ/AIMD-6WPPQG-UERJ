NAME = preparacao_termica.inp
|  1> # Minicurso AIMD / ORCA 6.1.1 - preparacao_termica
|  2> # Estas linhas de comentario explicam as escolhas e nao alteram o calculo.
|  3> # Execute um caso por vez; mantenha o arquivo XYZ na pasta de execucao.
|  4> 
|  5> # Integra o movimento dos nucleos. PAL8 solicita oito recursos. XTB2 chama
|  6> # GFN2-xTB externo; PAL8 tambem define suas threads. ALPB(water) representa o
|  7> # ambiente continuo.
|  8> ! MD XTB2 ALPB(water) PAL8
|  9> 
| 10> # Memoria em MB por processo. 256 x 8 = 2048 MB de orcamento, alem de memoria
| 11> # adicional.
| 12> %maxcore 256
| 13> 
| 14> # Parametros da dinamica: as unidades sao explicitas em cada linha.
| 15> %md
| 16>   # Passo de integracao em femtossegundos. 1 fs = 1e-15 s.
| 17>   Timestep 0.5_fs
| 18>   # Semente fixa para repetir a preparacao aleatoria no mesmo ambiente.
| 19>   Randomize 42
| 20>   # Inicializa velocidades na temperatura indicada; nao substitui um
| 21>   # termostato.
| 22>   Initvel 300_K
| 23>   # Banho CSVR a 300 K; Timecon 100 fs regula o acoplamento. A temperatura
| 24>   # pode flutuar.
| 25>   Thermostat CSVR 300_K Timecon 100_fs
| 26>   # Parede harmonica esferica; centro e raio em angstrom. Spring em kJ mol-1
| 27>   # A-2; nao e caixa periodica.
| 28>   Cell Sphere 0, 0, 0, 6.0_A Spring 10.0
| 29>   # Mede uma distancia, sem impor restricao. Indices atomicos comecam em zero:
| 30>   # Zn=0, N=1 e 4.
| 31>   Manage_Colvar Define 1 Distance Atom 0 Atom 1
| 32>   # Mede uma distancia, sem impor restricao. Indices atomicos comecam em zero:
| 33>   # Zn=0, N=1 e 4.
| 34>   Manage_Colvar Define 2 Distance Atom 0 Atom 4
| 35>   # Mede uma distancia, sem impor restricao. Indices atomicos comecam em zero:
| 36>   # Zn=0, N=1 e 4.
| 37>   Manage_Colvar Define 3 Distance Atom 0 Atom 13
| 38>   # Mede uma distancia, sem impor restricao. Indices atomicos comecam em zero:
| 39>   # Zn=0, N=1 e 4.
| 40>   Manage_Colvar Define 4 Distance Atom 0 Atom 16
| 41>   # Mede uma distancia, sem impor restricao. Indices atomicos comecam em zero:
| 42>   # Zn=0, N=1 e 4.
| 43>   Manage_Colvar Define 5 Distance Atom 0 Atom 19
| 44>   # Mede uma distancia, sem impor restricao. Indices atomicos comecam em zero:
| 45>   # Zn=0, N=1 e 4.
| 46>   Manage_Colvar Define 6 Distance Atom 0 Atom 22
| 47>   # Mede uma distancia, sem impor restricao. Indices atomicos comecam em zero:
| 48>   # Zn=0, N=1 e 4.
| 49>   Manage_Colvar Define 7 Distance Atom 0 Atom 25
| 50>   # Mede uma distancia, sem impor restricao. Indices atomicos comecam em zero:
| 51>   # Zn=0, N=1 e 4.
| 52>   Manage_Colvar Define 8 Distance Atom 0 Atom 28
| 53>   # Mede uma distancia, sem impor restricao. Indices atomicos comecam em zero:
| 54>   # Zn=0, N=1 e 4.
| 55>   Manage_Colvar Define 9 Distance Atom 0 Atom 31
| 56>   # Mede uma distancia, sem impor restricao. Indices atomicos comecam em zero:
| 57>   # Zn=0, N=1 e 4.
| 58>   Manage_Colvar Define 10 Distance Atom 0 Atom 34
| 59>   # Mede uma distancia, sem impor restricao. Indices atomicos comecam em zero:
| 60>   # Zn=0, N=1 e 4.
| 61>   Manage_Colvar Define 11 Distance Atom 0 Atom 37
| 62>   # Mede uma distancia, sem impor restricao. Indices atomicos comecam em zero:
| 63>   # Zn=0, N=1 e 4.
| 64>   Manage_Colvar Define 12 Distance Atom 0 Atom 40
| 65>   # Grava um quadro XYZ por passo. O nome identifica esta trajetoria.
| 66>   Dump Position Stride 1 Filename "preparacao_termica-traj.xyz"
| 67>   # Numero de passos desta etapa. Duracao fisica = numero de passos x
| 68>   # timestep.
| 69>   Run 200
| 70> end
| 71> 
| 72> # Le o XYZ: carga total 2, multiplicidade 1. O nome do arquivo deve coincidir
| 73> # exatamente.
| 74> * xyzfile 2 1 zn_solvato.xyz
| 75> 
| 76>                          ****END OF INPUT****
