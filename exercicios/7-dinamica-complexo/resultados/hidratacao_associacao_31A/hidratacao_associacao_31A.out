NAME = hidratacao_associacao_31A.inp
|  1> # Montagem fora do equilibrio: aguas a 3.1 A; en a pelo menos 6.5 A.
|  2> ! MD XTB2 ALPB(water) PAL8
|  3> %maxcore 256
|  4> 
|  5> %md
|  6>   Timestep 0.25_fs
|  7>   Randomize 42
|  8>   Initvel 300_K
|  9>   # Contencao distante; sem atracao imposta Zn-O ou Zn-N.
| 10>   Walls Sphere 0, 0, 0, 12.0_A Spring 50.0
| 11>   Dump Position Stride 2 Filename "hidratacao_associacao_31A-traj.xyz"
| 12>   # Dissipar o calor de formacao da primeira camada (0.5 ps).
| 13>   Thermostat CSVR 300_K Timecon 20_fs
| 14>   Run 2000
| 15>   # Observar os encontros com acoplamento mais fraco (4.5 ps).
| 16>   Thermostat CSVR 300_K Timecon 100_fs
| 17>   Run 18000
| 18> end
| 19> 
| 20> * xyzfile 2 1 zn_aguas_en_31A.xyz
| 21> 
| 22>                          ****END OF INPUT****
