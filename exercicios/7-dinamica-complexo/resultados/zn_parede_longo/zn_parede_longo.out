NAME = zn_parede_longo.inp
|  1> # Complexo com XTB2/ALPB; PAL8 = 8 threads do xTB.
|  2> ! MD XTB2 ALPB(water) PAL8
|  3> %maxcore 256
|  4> 
|  5> %md
|  6>   Timestep 0.5_fs
|  7>   Randomize 42
|  8>   # Banho a 300 K; acoplamento em 100 fs.
|  9>   Thermostat CSVR 300_K Timecon 100_fs
| 10>   # Parede suave: centro (0,0,0), raio 6 A.
| 11>   Walls Sphere 0, 0, 0, 6.0_A Spring 50.0
| 12>   # Retoma posicoes, velocidades e relogio fornecidos.
| 13>   Restart "preparacao_termica.mdrestart"
| 14>   Dump Position Stride 1 Filename "zn_parede_longo-traj.xyz"
| 15>   # Novo trecho: 4000 x 0.5 fs = 2000 fs (2e-12 s).
| 16>   Run 4000
| 17> end
| 18> 
| 19> # Carga 2, multiplicidade 1; XYZ na mesma pasta.
| 20> * xyzfile 2 1 zn_solvato.xyz
| 21> 
| 22>                          ****END OF INPUT****
