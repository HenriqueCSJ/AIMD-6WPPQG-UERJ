NAME = t600_gota.inp
|  1> # Comparacao didatica: mesma gota e checkpoint do controle a 300 K.
|  2> ! MD XTB2 ALPB(water) PAL8
|  3> %maxcore 256
|  4> %md
|  5>   Timestep 0.25_fs
|  6>   Walls Sphere 0, 0, 0, 8.5_A Spring 10
|  7>   Dump Position Stride 2 Filename "t600_gota-traj.xyz"
|  8>   Randomize 93102
|  9>   Restart "p03_equilibrar.mdrestart"
| 10> 
| 11>   # Subir o alvo de 300 para 600 K ao longo de 0.5 ps.
| 12>   Thermostat CSVR 300_K Timecon 100_fs Ramp 600_K
| 13>   Run 2000
| 14> 
| 15>   # A rampa terminou: os proximos 1.5 ps mantem o alvo em 600 K.
| 16>   Run 6000
| 17> end
| 18> * xyzfile 1 1 gota_equilibrar.xyz
| 19> 
| 20>                          ****END OF INPUT****
