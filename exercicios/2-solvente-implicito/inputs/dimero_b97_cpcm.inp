# Exemplo didatico; oito processos solicitados.
! MD B97-3c TightSCF CPCM(water) PAL8
%maxcore 256

%md
  Randomize 42
  Initvel 300_K
  Dump Position Stride 1 Filename "dimero_b97_cpcm-traj.xyz"
  Timestep 0.5_fs
  Thermostat None
  # 60 fs: observar vibracao e geometria da ligacao H.
  Run 120
end
