NAME = etanol_dt200.inp
|  1> # Minicurso AIMD / ORCA 6.1.1 - etanol_dt200
|  2> # Estas linhas de comentario explicam as escolhas e nao alteram o calculo.
|  3> # Execute um caso por vez; mantenha o arquivo XYZ na pasta de execucao.
|  4> 
|  5> # MD integra o movimento; Opt relaxa a geometria (quando presente). PAL8 solicita oito recursos. XTB2 chama GFN2-xTB externo; PAL8 tambem define suas threads.
|  6> ! MD XTB2 PAL8
|  7> 
|  8> # Memoria em MB por processo. 256 x 8 = 2048 MB de orcamento, alem de memoria adicional.
|  9> %maxcore 256
| 10> 
| 11> # Parametros da dinamica: as unidades sao explicitas em cada linha.
| 12> %md
| 13> # Passo de integracao em femtossegundos. 1 fs = 1e-15 s.
| 14> Timestep 2.0_fs
| 15> # Semente fixa para repetir a preparacao aleatoria no mesmo ambiente.
| 16> Randomize 42
| 17> # Inicializa velocidades na temperatura indicada; nao substitui um termostato.
| 18> Initvel 300_K
| 19> # Sem troca de energia com banho: controle NVE para examinar a integracao.
| 20> Thermostat None
| 21> # Grava um quadro XYZ por passo. O nome identifica esta trajetoria.
| 22> Dump Position Stride 1 Filename "etanol_dt200-traj.xyz"
| 23> # Numero de passos desta etapa. Duracao fisica = numero de passos x timestep.
| 24> Run 250
| 25> end
| 26> 
| 27> # Le o XYZ: carga total 0, multiplicidade 1. O nome do arquivo deve coincidir exatamente.
| 28> * xyzfile 0 1 etanol.xyz
| 29> 
| 30>                          ****END OF INPUT****
