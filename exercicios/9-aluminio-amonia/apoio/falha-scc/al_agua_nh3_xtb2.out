NAME = al_agua_nh3_xtb2.inp
|  1> # Caso fornecido: Al3+ + 6 aguas + NH3, agora com XTB2.
|  2> ! MD XTB2 PAL8
|  3> %maxcore 256
|  4> %md
|  5>   # Semente fixa para reproduzir as velocidades iniciais.
|  6>   Randomize 42
|  7>   Initvel 300_K
|  8>   # Preserva o passo e o banho do exemplo; conferir a sensibilidade ao passo.
|  9>   Timestep 1.0_fs
| 10>   Thermostat Berendsen 300_K Timecon 20.0_fs
| 11>   Dump Position Stride 1 Filename "al_agua_nh3_xtb2-traj.xyz"
| 12>   # 2000 x 1 fs = 2 ps = 2e-12 s.
| 13>   Run 2000
| 14> end
| 15> # Carga total +3 e multiplicidade 1; geometria original sem pre-otimizacao.
| 16> * xyzfile 3 1 al_agua_nh3.xyz
| 17> 
| 18>                          ****END OF INPUT****
