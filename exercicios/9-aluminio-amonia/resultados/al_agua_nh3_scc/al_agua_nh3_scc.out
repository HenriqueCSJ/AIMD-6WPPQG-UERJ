NAME = al_agua_nh3_scc.inp
|  1> # Caso fornecido: Al3+ + 6 aguas + NH3, agora com XTB2.
|  2> ! MD XTB2 PAL8
|  3> %maxcore 256
|  4> # Reduz a mistura SCC para esta geometria ionica; requer scc.inp.
|  5> %xtb
|  6>   XTBINPUTSTRING "--input scc.inp"
|  7> end
|  8> %md
|  9>   # Semente fixa para reproduzir as velocidades iniciais.
| 10>   Randomize 42
| 11>   Initvel 300_K
| 12>   # Preserva o passo e o banho do exemplo; conferir a sensibilidade ao passo.
| 13>   Timestep 1.0_fs
| 14>   Thermostat Berendsen 300_K Timecon 20.0_fs
| 15>   Dump Position Stride 1 Filename "al_agua_nh3_scc-traj.xyz"
| 16>   # 2000 x 1 fs = 2 ps = 2e-12 s.
| 17>   Run 2000
| 18> end
| 19> # Carga total +3 e multiplicidade 1; geometria original sem pre-otimizacao.
| 20> * xyzfile 3 1 al_agua_nh3.xyz
| 21> 
| 22>                          ****END OF INPUT****
