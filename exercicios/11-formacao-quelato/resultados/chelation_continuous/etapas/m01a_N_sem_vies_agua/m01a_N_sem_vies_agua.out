NAME = m01a_N_sem_vies_agua.inp
|  1> # Encontro real hidratado: trecho assistido, sem significado cinetico.
|  2> ! MD XTB2 ALPB(water) PAL8
|  3> %maxcore 256
|  4> %md
|  5>   Timestep 0.25_fs
|  6>   Randomize 93001
|  7>   Initvel 300_K
|  8>   Thermostat CSVR 300_K Timecon 100_fs
|  9>   Walls Sphere 0, 0, 0, 9.0_A Spring 50.0
| 10>   Dump Position Stride 4 Filename "m01a_N_sem_vies_agua-traj.xyz"
| 11>   Manage_Colvar Define 1 Distance Atom 0 Atom 61
| 12>   Manage_Colvar Define 2 Distance Atom 0 Atom 64
| 13>   Manage_Colvar Define 3 CoordNumber Atom 0 Group 1 4 7 10 13 16 19 22 25 28 31 34 37 40 43 46 49 52 55 58 Cutoff 2.6_A
| 14>   # Aproximar apenas N61; todas as aguas e N64 ficam sem vies.
| 15>   # Upper nao obriga a agua individual nem impoe ligacoes covalentes.
| 16>   Restraint Add Colvar 1 Harmonic Spring 200.0 Upper Ramp 3.886868 2.2
| 17>   Run 4000
| 18>   # Revisar antes de retirar o unico vies em outro bloco.
| 19> end
| 20> * xyzfile 2 1 encontro_real_R1.xyz
| 21> 
| 22>                          ****END OF INPUT****
