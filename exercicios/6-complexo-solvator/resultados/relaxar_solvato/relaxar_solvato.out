NAME = relaxar_solvato.inp
|  1> # Minicurso AIMD / ORCA 6.1.1 - relaxar_solvato
|  2> # Estas linhas de comentario explicam as escolhas e nao alteram o calculo.
|  3> # Execute um caso por vez; mantenha o arquivo XYZ na pasta de execucao.
|  4> 
|  5> # Relaxa a geometria. PAL8 solicita oito recursos. XTB2 chama GFN2-xTB
|  6> # externo; PAL8 tambem define suas threads. ALPB(water) representa o ambiente
|  7> # continuo.
|  8> ! XTB2 ALPB(water) Opt TightOpt PAL8
|  9> 
| 10> # Memoria em MB por processo. 256 x 8 = 2048 MB de orcamento, alem de memoria
| 11> # adicional.
| 12> %maxcore 256
| 13> 
| 14> # Limite de ciclos da otimizacao; conferir se o criterio de convergencia foi
| 15> # realmente atingido.
| 16> %geom MaxIter 300 end
| 17> # Le o XYZ: carga total 2, multiplicidade 1. O nome do arquivo deve coincidir
| 18> # exatamente.
| 19> * xyzfile 2 1 zn_solvator.xyz
| 20> 
| 21>                          ****END OF INPUT****
