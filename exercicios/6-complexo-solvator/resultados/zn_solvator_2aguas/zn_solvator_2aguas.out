NAME = zn_solvator_2aguas.inp
|  1> # Minicurso AIMD / ORCA 6.1.1 - zn_solvator_2aguas
|  2> # Estas linhas de comentario explicam as escolhas e nao alteram o calculo.
|  3> # Execute um caso por vez; mantenha o arquivo XYZ na pasta de execucao.
|  4> 
|  5> # Calcula energias e forcas para a montagem do solvente. PAL8 solicita oito
|  6> # recursos. XTB2 chama GFN2-xTB externo; PAL8 tambem define suas threads.
|  7> # ALPB(water) representa o ambiente continuo.
|  8> ! XTB2 ALPB(water) PAL8
|  9> 
| 10> # Memoria em MB por processo. 256 x 8 = 2048 MB de orcamento, alem de memoria
| 11> # adicional.
| 12> %maxcore 256
| 13> 
| 14> # Monta um candidato com solvente explicito; nao e uma simulacao temporal de
| 15> # MD.
| 16> %solvator
| 17>   # Numero de novas moleculas de agua, definido por ALPB(water). Cada agua
| 18>   # acrescenta 3 atomos.
| 19>   nsolv 2
| 20>   # DOCKING procura posicoes para cada nova molecula de solvente.
| 21>   clustermode docking
| 22>   # Mantem o soluto fixo somente durante a montagem. A relaxacao posterior
| 23>   # libera todos os atomos.
| 24>   fixsolute true
| 25> end
| 26> 
| 27> # Le o XYZ: carga total 2, multiplicidade 1. O nome do arquivo deve coincidir
| 28> # exatamente.
| 29> * xyzfile 2 1 zn_en.xyz
| 30> 
| 31>                          ****END OF INPUT****
