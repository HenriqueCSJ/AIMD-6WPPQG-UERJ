NAME = preparar_complexo.inp
|  1> # Minicurso AIMD / ORCA 6.1.1 - preparar_complexo
|  2> # Estas linhas de comentario explicam as escolhas e nao alteram o calculo.
|  3> # Execute um caso por vez; mantenha o arquivo XYZ na pasta de execucao.
|  4> 
|  5> # MD integra o movimento; Opt relaxa a geometria (quando presente). PAL8 solicita oito recursos. XTB2 chama GFN2-xTB externo; PAL8 tambem define suas threads. ALPB(water) representa o ambiente continuo.
|  6> ! XTB2 ALPB(water) Opt TightOpt PAL8
|  7> 
|  8> # Memoria em MB por processo. 256 x 8 = 2048 MB de orcamento, alem de memoria adicional.
|  9> %maxcore 256
| 10> 
| 11> # Limite de ciclos da otimizacao; conferir se o criterio de convergencia foi realmente atingido.
| 12> %geom MaxIter 300 end
| 13> # Le o XYZ: carga total 2, multiplicidade 1. O nome do arquivo deve coincidir exatamente.
| 14> * xyzfile 2 1 zn_en_inicial.xyz
| 15> 
| 16>                          ****END OF INPUT****
