NAME = etanol_etapas.inp
|  1> # Exemplo didatico; oito processos solicitados.
|  2> ! MD XTB2 PAL8
|  3> %maxcore 256
|  4> 
|  5> %md
|  6>   Randomize 42
|  7>   Initvel 300_K
|  8>   Dump Position Stride 1 Filename "etanol_etapas-traj.xyz"
|  9>   Timestep 0.5_fs
| 10>   # 0-0.5 ps: inicio a 300 K.
| 11>   Thermostat CSVR 300_K Timecon 100_fs
| 12>   Run 1000
| 13>   # 0.5-1.5 ps: aquecer gradualmente ate 600 K.
| 14>   Thermostat CSVR 300_K Timecon 100_fs Ramp 600_K
| 15>   Run 2000
| 16>   # 1.5-3.5 ps: manter o alvo final da rampa.
| 17>   Run 4000
| 18>   # 3.5-4.5 ps: resfriar gradualmente.
| 19>   Thermostat CSVR 600_K Timecon 100_fs Ramp 300_K
| 20>   Run 2000
| 21>   # 4.5-5 ps: continuar a 300 K, sem reiniciar velocidades.
| 22>   Run 1000
| 23> end
| 24> * xyzfile 0 1 etanol.xyz
| 25> 
| 26>                          ****END OF INPUT****
