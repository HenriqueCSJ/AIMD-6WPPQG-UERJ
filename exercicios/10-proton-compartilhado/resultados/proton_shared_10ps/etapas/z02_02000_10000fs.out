NAME = z02_02000_10000fs.inp
|  1> # H5O2+: continue the retained 2 ps state for 8 ps, reaching 10 ps.
|  2> # Same Hamiltonian, integration step, thermostat settings and explicit seed.
|  3> # Positions and velocities come from the checkpoint; do not initialize velocities.
|  4> ! MD XTB2 PAL8
|  5> %maxcore 256
|  6> %md
|  7>   Timestep 0.25_fs
|  8>   Thermostat CSVR 300_K Timecon 100_fs
|  9>   Dump Position Stride 1 Filename "z02_02000_10000fs-traj.xyz"
| 10>   Randomize 93201
| 11>   Restart "z01_dinamica.mdrestart"
| 12>   Run 32000
| 13> end
| 14> * xyzfile 1 1 h5o2_restart_2ps.xyz
| 15> 
| 16>                          ****END OF INPUT****
