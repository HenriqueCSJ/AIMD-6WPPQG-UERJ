NAME = agua_c60.inp
|  1> # Agua encapsulada: todos os atomos da gaiola se movem.
|  2> ! MD XTB2 PAL8
|  3> %maxcore 256
|  4> 
|  5> %md
|  6>   Timestep 0.5_fs
|  7>   Randomize 42
|  8>   Initvel 300_K
|  9>   # Banho termico; o confinamento vem do proprio C60.
| 10>   Thermostat CSVR 300_K Timecon 100_fs
| 11>   Dump Position Stride 1 Filename "agua_c60-traj.xyz"
| 12>   # 2000 x 0.5 fs = 1 ps (1e-12 s).
| 13>   Run 2000
| 14> end
| 15> 
| 16> # Neutro, singlete; geometria previamente relaxada.
| 17> * xyzfile 0 1 agua_c60.xyz
| 18> 
| 19>                          ****END OF INPUT****
